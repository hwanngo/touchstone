{
  "config": {
    "MD012": false,
    "MD013": false,
    "MD022": false,
    "MD024": { "siblings_only": true },
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD041": false,
    "MD049": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  // tests/fixtures/ and evals/cases/*/repo/ both hold deliberately-malformed markdown used to
  // prove the gates detect it. Linting either would fail by construction, so both are excluded
  // here for the same reason scripts/check-links.sh excludes them from the link scan.
  "ignores": [
    "**/node_modules/**",
    "**/.superpowers/**",
    "tests/fixtures/**",
    "evals/cases/*/repo/**"
  ]
}
