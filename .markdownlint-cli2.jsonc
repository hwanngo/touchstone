{
  "config": {
    "MD012": false,
    "MD013": false,
    "MD022": false,
    "MD024": { "siblings_only": true },
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD041": false,
    "MD049": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  // tests/fixtures/ holds deliberately-malformed markdown used to prove the gates
  // detect it. Linting it would fail by construction, so it is excluded here for the
  // same reason scripts/check-links.sh excludes it from the link scan.
  "ignores": [
    "**/node_modules/**",
    "**/.superpowers/**",
    "tests/fixtures/**"
  ]
}
